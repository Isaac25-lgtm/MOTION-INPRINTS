# Motion Imprints — parent site
# Development defaults only. Production domains are unconfirmed.
# Set these on the Render service for this application. Do not commit real secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TECHNOLOGIES_URL=http://localhost:3001

# Search engines stay out until this is true AND the site URL is public https.
ALLOW_INDEXING=false

# Public contact channels. Each renders only when set. The owner supplies them.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_CONTACT_MAP_URL=

# Server only. Neon pooled connection string for quote requests and messages.
# Without it the forms answer "not available" and nothing is stored.
DATABASE_URL=

# Server only, optional. A webhook (Slack, Teams, automation) told about each
# new request. Failure never loses a request.
NOTIFY_WEBHOOK_URL=

# Server only, optional. Rate-limit client address: a header a trusted edge
# overwrites, or the number of proxy hops appended to X-Forwarded-For.
RATE_LIMIT_IP_HEADER=
TRUSTED_PROXY_HOPS=1

# Server only, optional. The "Ask Motion" assistant uses this website's own
# Anthropic API key (never a developer's or a shell's credentials). Without it
# the assistant offers "talk to a person" only.
MOTION_ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# Development only: QUOTE_STORE=memory lets the forms complete without a
# database. Ignored in production.
QUOTE_STORE=
