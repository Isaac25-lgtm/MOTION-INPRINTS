# Motion Imprints Technologies — technology division site
# Development defaults only. Production domains are unconfirmed.
# Set these on the Render service for this application. Do not commit real secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_PARENT_URL=http://localhost:3000

# Search engines stay out until this is true AND the site URL is public https.
ALLOW_INDEXING=false

# Public contact channels. Each renders only when set. The owner supplies them.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=

# Server only. Neon pooled connection string (shared database, site column).
DATABASE_URL=

# Server only, optional. Webhook told about each new inquiry.
NOTIFY_WEBHOOK_URL=

# Server only, optional. Rate-limit client address header or proxy hops.
RATE_LIMIT_IP_HEADER=
TRUSTED_PROXY_HOPS=1

# Server only, optional. The "Ask Motion" assistant uses this website's own
# Anthropic API key (never a developer's or a shell's credentials). Without it
# the assistant offers "talk to a person" only.
MOTION_ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# Development only: QUOTE_STORE=memory lets the form complete without a database.
QUOTE_STORE=
