# Browser-safe: Vite exposes only values prefixed with VITE_.
VITE_APP_NAME=Motion
VITE_APP_URL=http://localhost:5173
# Use the local secure API origin in development; set this to the deployed API origin in Render.
VITE_API_BASE_URL=http://localhost:8787/api

# Neon Auth (Managed Better Auth). PUBLIC — this is the only auth value the
# browser needs, and it ships in the bundle by design. There is no publishable
# key and no project id: those belonged to the old Stack Auth integration and the
# app now refuses to start if they are still set.
# Neon Console -> Auth -> Configuration -> Auth URL. Include the full path.
VITE_NEON_AUTH_URL=https://ep-lingering-sound-ax1eilc4.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth

# PUBLIC. Whether to offer "Continue with Google". Google is enabled per-project
# in the Neon console and the browser cannot detect it, so it is declared here.
# Leave unset (or anything but "false") to show the button.
VITE_NEON_AUTH_GOOGLE=

# Public base URL for published media. Blank means storage is not connected, and
# the media library says so instead of showing an empty list as if it worked.
VITE_STORAGE_PUBLIC_BASE_URL=

# Server-only: configure in the API/Neon Functions runtime. Never prefix these with VITE_.
# DATABASE_URL is SECRET — it carries the database password.
DATABASE_URL=

# Neon Auth token verification. Both are public values, but they belong to the
# server and are not needed in the browser.
#
#   JWKS  = the Auth URL plus /.well-known/jwks.json
#   ISSUER = the ORIGIN of the Auth URL, with NO path.
#
# The common mistake is pasting the same string into both. Tokens then verify
# cryptographically and fail on the issuer claim, which looks like a broken
# login rather than a misconfiguration — so the server validates this on boot.
NEON_AUTH_JWKS_URL=https://ep-lingering-sound-ax1eilc4.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://ep-lingering-sound-ax1eilc4.neonauth.c-4.us-east-2.aws.neon.tech
# Comma-separated. localhost and 127.0.0.1 are distinct origins to a browser, so
# both are listed locally. In production this is the site's real origin only.
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Header your API runtime overwrites with the real client address. Required in production.
# Leave blank locally; anonymous callers are then not rate limited because they cannot be told apart.
API_TRUSTED_CLIENT_HEADER=
API_REQUEST_TIMEOUT_MS=10000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_MAX_KEYS=10000
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_SIGNING_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER_API_KEY=
