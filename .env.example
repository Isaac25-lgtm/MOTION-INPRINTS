# Browser-safe: Vite exposes only values prefixed with VITE_.
VITE_APP_NAME=Motion
VITE_APP_URL=http://localhost:5173
# Use the local secure API origin in development; set this to the deployed API origin in Render.
VITE_API_BASE_URL=http://localhost:8787/api

# Supabase Auth — PUBLIC. The project origin and the publishable (anon) key.
# The service_role key must NEVER be given a VITE_ name.
# Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# PUBLIC. Whether to offer "Continue with Google". Google is enabled per-project
# in the Supabase dashboard and the browser cannot detect it, so it is declared.
# Leave unset (or anything but "false") to show the button.
VITE_SUPABASE_GOOGLE=

# Optional override for the public catalogue-image prefix. Blank derives
# {VITE_SUPABASE_URL}/storage/v1/object/public/motion-public
VITE_STORAGE_PUBLIC_BASE_URL=

# Server-only: configure in the API runtime. Never prefix these with VITE_.
# DATABASE_URL is SECRET — it carries the database password.
# Direct (db.<ref>.supabase.co:5432) is preferred when IPv6 works.
# Session Pooler (*.pooler.supabase.com:5432) is the IPv4 fallback for
# migrations and the persistent Node API. Never Transaction Pooler port 6543.
# See SUPABASE.md.
DATABASE_URL=

# Server-side Supabase. URL is the same public origin as VITE_SUPABASE_URL.
# SERVICE_ROLE_KEY is SECRET and API-only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY. Comma-separated addresses of the two people who may reach the
# management dashboard at /manager. Never prefix with VITE_ and never place in
# the static site. An address alone grants nothing: the server checks it against
# the confirmed email Supabase Auth holds for the signed-in session, and refuses
# any address that has not been confirmed. Empty approves nobody.
OWNER_ALLOWED_EMAILS=

# Comma-separated. localhost and 127.0.0.1 are distinct origins to a browser, so
# both are listed locally. In production this is the site's real origin only.
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Header your API runtime overwrites with the real client address. Required in production.
# Leave blank locally; anonymous callers are then not rate limited because they cannot be told apart.
API_TRUSTED_CLIENT_HEADER=
API_REQUEST_TIMEOUT_MS=10000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_MAX_KEYS=10000
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER_API_KEY=
