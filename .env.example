# Browser-safe: Vite exposes only values prefixed with VITE_.
VITE_APP_NAME=Motion
VITE_APP_URL=http://localhost:5173
# Use the local API origin in development; set this to the deployed API origin in Render.
VITE_API_BASE_URL=http://localhost:8787/api

# Optional override for public catalogue-image URLs once object storage is connected.
# Leave blank while storage is unconfigured.
VITE_STORAGE_PUBLIC_BASE_URL=

# Server-only: configure in the API runtime. Never prefix these with VITE_.
# DATABASE_URL is SECRET — the Neon pooled runtime URI (often ending -pooler).
# Add sslmode=require. Channel binding may be requested with channel_binding=require
# when the driver and Neon endpoint support it. Do not rewrite the URI in code.
DATABASE_URL=

# Direct, unpooled Neon URI for migrations and dumps. SECRET. Never put this on
# the frontend service. Required when DATABASE_URL is pooled, because migrations
# take a session advisory lock. Local development may fall back to a direct
# DATABASE_URL (localhost) instead.
MIGRATION_DATABASE_URL=

# SERVER-ONLY. JSON array of administrators. Each entry needs a stable UUID,
# a unique username, and a scrypt password hash from scripts/hash-admin-password.js.
# Example shape (hashes only — never a plaintext password):
# [{"id":"11111111-1111-4111-8111-111111111111","username":"ada","passwordHash":"scrypt$..."}]
# Required in production. Empty outside production means nobody can sign in at /manager.
ADMIN_USERS_JSON=

# Session lifetime in hours. Defaults to 8. Allowed range 1–168.
ADMIN_SESSION_HOURS=8

# Comma-separated. localhost and 127.0.0.1 are distinct origins to a browser, so
# both are listed locally. In production this is the site's real origin only.
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Header your API runtime overwrites with the real client address. Required in production.
# Leave blank locally; anonymous callers are then not rate limited because they cannot be told apart.
API_TRUSTED_CLIENT_HEADER=
API_REQUEST_TIMEOUT_MS=10000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_MAX_KEYS=10000
# Shared per-endpoint fallback when no trusted client address is available.
API_ANONYMOUS_MUTATION_MAX=20
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PROVIDER_API_KEY=
